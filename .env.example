# Copiar a .env y ajustar. El archivo .env NO se versiona.
# Los valores de ejemplo son solo para desarrollo local.

# ---------- PostgreSQL (superusuario del contenedor) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ---------- Credenciales por base ----------
# Deben coincidir con infra/init-db.sql (un .sql no lee variables de entorno).
PEDIDOS_DB_USER=pedidos_user
PEDIDOS_DB_PASSWORD=pedidos_pass
DESPACHO_DB_USER=despacho_user
DESPACHO_DB_PASSWORD=despacho_pass
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_pass

# ---------- Keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Host publico de Keycloak: define el claim "iss" de los tokens.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/logistica
# JWKS resuelto dentro de la red de Docker (el host publico no es alcanzable
# desde los contenedores).
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/logistica/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URI=http://keycloak:8080/realms/logistica/protocol/openid-connect/token

# ---------- Client confidencial para llamadas entre servicios ----------
SERVICE_CLIENT_ID=logistica-service
# Debe coincidir con el secret del client en infra/realm-logistica.json.
SERVICE_CLIENT_SECRET=dev-service-secret-cambiar

# ---------- Google Maps ----------
# Clave real: NUNCA commitearla. Pegarla solo en el .env local.
GOOGLE_MAPS_API_KEY=tu-api-key-de-google-aca
