# Configuración opcional de docker compose. Sin archivo .env todo arranca con los valores
# por defecto. Para cambiar alguno: copiar este archivo a ".env" (no se versiona) y descomentar.

# --- Infraestructura (las lee docker-compose.yml) ---
# Contraseña del superusuario de PostgreSQL. Solo se aplica al crear el volumen por primera vez.
# POSTGRES_PASSWORD=postgres
# Administrador de la consola de Keycloak (http://localhost:8180)
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# --- pedidos-service: mails de cambio de estado ---
# Cuenta de Gmail remitente y su contraseña de aplicación (16 caracteres, sin espacios)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# Casillas que reciben copia oculta de cada mail, separadas por coma
# MAIL_COPIA=

# --- despacho-service: distancias ---
# Servidor OSRM. Por defecto se usa el público (https://router.project-osrm.org).
# Con uno propio levantado en la máquina: http://host.docker.internal:5000
# OSRM_URL=
