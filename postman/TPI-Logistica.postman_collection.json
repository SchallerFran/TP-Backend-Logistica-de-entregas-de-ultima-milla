    {
      "name": "3. Planificación (despachante)",
      "description": "El despachante planifica el centro y la fecha: arma las rutas, deja como no asignable el pedido fuera de cobertura y lo reprograma. El cliente cancela un pedido ya asignado y la ruta se recalcula (F04, F06, F07, F08).",
      "item": [
        {
          "name": "P2 Planificar el día",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/despacho/planificaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"centroId\": {{centroId}},\n  \"fecha\": \"{{fecha}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "",
                  "const r = pm.response.json();",
                  "pm.test('Planificación CONFIRMADA', () => pm.expect(r.estado).to.eql('CONFIRMADA'));",
                  "const env = k => Number(pm.environment.get(k));",
                  "const rutaDe = id => r.rutas.find(x => x.paradas.some(p => p.pedidoId === id));",
                  "const principal = rutaDe(env('pedidoUrgenteId'));",
                  "pm.test('RN07/RN08: el urgente y el normal quedan en la misma ruta', () => {",
                  "    pm.expect(principal).to.be.an('object');",
                  "    pm.expect(principal.paradas.map(p => p.pedidoId)).to.include(env('pedidoId'));",
                  "});",
                  "pm.test('RN10: el pedido fuera de cobertura queda no asignable con su motivo', () => {",
                  "    const na = r.noAsignables.find(x => x.pedidoId === env('pedidoFueraId'));",
                  "    pm.expect(na).to.be.an('object');",
                  "    pm.expect(JSON.stringify(na)).to.include('FUERA_DE_COBERTURA');",
                  "});",
                  "pm.test('RN18: informa de dónde salieron las distancias', () => pm.expect(r.fuentesDistancia).to.be.an('object'));",
                  "pm.environment.set('rutaId', principal.id);",
                  "pm.environment.set('rutaCanceladoId', rutaDe(env('pedidoCancelarId')).id);",
                  "// El planificador elige el repartidor: se usa el token del que recibió la ruta principal",
                  "const esJuan = principal.repartidor.includes('Juan');",
                  "pm.environment.set('tokenRepartidorRuta', pm.environment.get(esJuan ? 'tokenRepartidor1' : 'tokenRepartidor2'));",
                  "pm.environment.set('tokenRepartidorOtro', pm.environment.get(esJuan ? 'tokenRepartidor2' : 'tokenRepartidor1'));",
