{
  "info": {
    "name": "TPI Logística",
    "description": "Todo va contra el gateway. Cada carpeta se loguea sola en Keycloak con su usuario (contraseña = usuario) y cachea el token. Los IDs creados se guardan en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date();",
          "const p = n => String(n).padStart(2, '0');",
          "pm.variables.set('hoy', d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "gateway",
      "value": "http://localhost:8080"
    },
    {
      "key": "keycloak",
      "value": "http://localhost:8180"
    },
    {
      "key": "centroId",
      "value": "1"
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "rutaId",
      "value": ""
    },
    {
      "key": "paradaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Cliente (cliente1)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const usuario = 'cliente1';",
              "const k = 'token_' + usuario;",
              "const exp = Number(pm.collectionVariables.get(k + '_exp') || 0);",
              "if (Date.now() < exp) {",
              "    pm.variables.set('token', pm.collectionVariables.get(k));",
              "} else {",
              "    pm.sendRequest({",
              "        url: pm.collectionVariables.get('keycloak') + '/realms/logistica/protocol/openid-connect/token',",
              "        method: 'POST',",
              "        header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
              "        body: { mode: 'urlencoded', urlencoded: [",
              "            { key: 'grant_type', value: 'password' },",
              "            { key: 'client_id', value: 'logistica-public' },",
              "            { key: 'username', value: usuario },",
              "            { key: 'password', value: usuario }",
              "        ]}",
              "    }, (err, res) => {",
              "        if (err || res.code !== 200) { console.error('Login fallido para ' + usuario, err || res.text()); return; }",
              "        const t = res.json();",
              "        pm.collectionVariables.set(k, t.access_token);",
              "        pm.collectionVariables.set(k + '_exp', String(Date.now() + (t.expires_in - 10) * 1000));",
              "        pm.variables.set('token', t.access_token);",
              "    });",
              "}"
            ]
          }
        }
      ],
